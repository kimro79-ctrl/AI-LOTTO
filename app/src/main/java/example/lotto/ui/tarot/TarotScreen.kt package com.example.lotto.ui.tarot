// File Path: app/src/main/java/com/kimro/ai/lotto/ui/tarot/TarotScreen.kt
package com.kimro.ai.lotto.ui.tarot

import android.widget.Toast
import androidx.compose.animation.core.animateFloatAsState
import androidx.compose.animation.core.tween
import androidx.compose.foundation.background
import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.itemsIndexed
import androidx.compose.foundation.shape.CircleShape
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.material.icons.Icons
import androidx.compose.material.icons.filled.AutoAwesome
import androidx.compose.material.icons.filled.Star
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.graphics.graphicsLayer
import androidx.compose.ui.platform.LocalContext
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.text.style.TextAlign
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp
import androidx.hilt.navigation.compose.hiltViewModel

@Composable
fun TarotScreen(
    viewModel: TarotViewModel = hiltViewModel()
) {
    var selectedSetCount by remember { mutableStateOf(5) }
    
    // 사용자가 터치한 카드 인덱스 (0, 1, 2)와 각 카드에 매칭될 타로 이름/컬러 저장
    var selectedCardIndex by remember { mutableStateOf<Int?>(null) }
    var isFlipped by remember { mutableStateOf(false) }
    
    // 뽑힌 카드의 고유 디자인 속성을 저장하기 위한 상태
    var revealedCardTitle by remember { mutableStateOf("") }
    var revealedCardColor by remember { mutableStateOf(Color(0xFFFFD166)) }

    val tarotCardName by viewModel.tarotCardName.collectAsState()
    val tarotMeaning by viewModel.tarotMeaning.collectAsState()
    val generatedTarotSets by viewModel.generatedTarotSets.collectAsState()
    val saveMessage by viewModel.saveMessage.collectAsState()

    val context = LocalContext.current

    LaunchedEffect(saveMessage) {
        saveMessage?.let {
            Toast.makeText(context, it, Toast.LENGTH_SHORT).show()
            viewModel.clearSaveMessage()
        }
    }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .padding(16.dp),
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        Text(
            text = "타로 카드 운세",
            style = MaterialTheme.typography.titleLarge,
            fontWeight = FontWeight.Bold
        )

        Spacer(modifier = Modifier.height(14.dp))

        // 조합 개수 선택 버튼 (5개 / 10개)
        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.spacedBy(8.dp)
        ) {
            Button(
                onClick = { selectedSetCount = 5 },
                colors = ButtonDefaults.buttonColors(
                    containerColor = if (selectedSetCount == 5) Color(0xFFD0BFFF) else Color(0xFFF0EDFF)
                ),
                modifier = Modifier.weight(1f),
                shape = RoundedCornerShape(10.dp)
            ) {
                Text(
                    text = "5개 조합",
                    fontWeight = FontWeight.Bold,
                    color = if (selectedSetCount == 5) Color(0xFF333333) else Color(0xFF777777)
                )
            }
            Button(
                onClick = { selectedSetCount = 10 },
                colors = ButtonDefaults.buttonColors(
                    containerColor = if (selectedSetCount == 10) Color(0xFFFFC6FF) else Color(0xFFFFF0F5)
                ),
                modifier = Modifier.weight(1f),
                shape = RoundedCornerShape(10.dp)
            ) {
                Text(
                    text = "10개 조합",
                    fontWeight = FontWeight.Bold,
                    color = if (selectedSetCount == 10) Color(0xFF333333) else Color(0xFF777777)
                )
            }
        }

        Spacer(modifier = Modifier.height(16.dp))

        Text(
            text = "아래 3장의 카드 중 오늘의 운세를 담은 한 장을 선택하세요",
            fontSize = 13.sp,
            color = Color.Gray,
            fontWeight = FontWeight.Medium
        )

        Spacer(modifier = Modifier.height(12.dp))

        // 3장의 타로 카드 배치 영역 (뒤집기 애니메이션 포함)
        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.SpaceEvenly
        ) {
            for (i in 0..2) {
                val isSelected = selectedCardIndex == i
                
                // 카드가 뒤집히는 회전각 애니메이션 (0도 -> 180도)
                val rotation by animateFloatAsState(
                    targetValue = if (isSelected && isFlipped) 180f else 0f,
                    animationSpec = tween(durationMillis = 600),
                    label = "CardFlip"
                )

                Card(
                    modifier = Modifier
                        .width(105.dp)
                        .height(150.dp)
                        .graphicsLayer {
                            rotationY = rotation
                            cameraDistance = 12f * density
                        }
                        .clickable {
                            if (selectedCardIndex == null) {
                                selectedCardIndex = i
                                isFlipped = true
                                viewModel.drawTarotCard(selectedSetCount)
                                
                                // 카드 종류에 따른 앞면 디자인 매핑
                                val possibleCards = listOf(
                                    Triple("마법사", Color(0xFF38BDF8), Icons.Default.AutoAwesome),
                                    Triple("여황제", Color(0xFFF472B6), Icons.Default.Star),
                                    Triple("운명의 루비", Color(0xFFFACC15), Icons.Default.AutoAwesome),
                                    Triple("태양", Color(0xFFFB923C), Icons.Default.Star)
                                )
                                val chosen = possibleCards.random()
                                revealedCardTitle = chosen.first
                                revealedCardColor = chosen.second
                            }
                        },
                    colors = CardDefaults.cardColors(
                        containerColor = if (rotation <= 90f) Color(0xFF4A4E69) else revealedCardColor
                    ),
                    elevation = CardDefaults.cardElevation(defaultElevation = 8.dp),
                    shape = RoundedCornerShape(16.dp)
                ) {
                    Box(
                        modifier = Modifier
                            .fillMaxSize()
                            .padding(8.dp),
                        contentAlignment = Alignment.Center
                    ) {
                        if (rotation <= 90f) {
                            // [카드 뒷면]
                            Column(horizontalAlignment = Alignment.CenterHorizontally) {
                                Text(text = "★", color = Color(0xFFFFD166), fontSize = 18.sp)
                                Spacer(modifier = Modifier.height(4.dp))
                                Text(
                                    text = "TAROT\n카드 ${i + 1}",
                                    color = Color.White,
                                    textAlign = TextAlign.Center,
                                    fontWeight = FontWeight.Bold,
                                    fontSize = 13.sp
                                )
                            }
                        } else {
                            // [카드 앞면] 글자 반전 보정
                            Box(
                                modifier = Modifier
                                    .fillMaxSize()
                                    .graphicsLayer { rotationY = 180f },
                                contentAlignment = Alignment.Center
                            ) {
                                Column(
                                    horizontalAlignment = Alignment.CenterHorizontally,
                                    verticalArrangement = Arrangement.Center
                                ) {
                                    Icon(
                                        imageVector = Icons.Default.AutoAwesome,
                                        contentDescription = null,
                                        tint = Color.White,
                                        modifier = Modifier.size(28.dp)
                                    )
                                    Spacer(modifier = Modifier.height(6.dp))
                                    Text(
                                        text = revealedCardTitle,
                                        color = Color.White,
                                        textAlign = TextAlign.Center,
                                        fontWeight = FontWeight.Bold,
                                        fontSize = 14.sp
                                    )
                                }
                            }
                        }
                    }
                }
            }
        }

        Spacer(modifier = Modifier.height(16.dp))

        // 다른 카드 다시 고르기 버튼
        if (selectedCardIndex != null) {
            Button(
                onClick = {
                    selectedCardIndex = null
                    isFlipped = false
                },
                modifier = Modifier.height(36.dp),
                colors = ButtonDefaults.buttonColors(containerColor = Color(0xFFE2E2E2)),
                shape = RoundedCornerShape(8.dp)
            ) {
                Text(text = "다른 카드 다시 고르기", fontSize = 12.sp, color = Color(0xFF333333))
            }
            Spacer(modifier = Modifier.height(12.dp))
        }

        if (generatedTarotSets.isNotEmpty()) {
            Button(
                onClick = { viewModel.saveAllTarotNumbers() },
                modifier = Modifier
                    .fillMaxWidth()
                    .height(48.dp),
                colors = ButtonDefaults.buttonColors(containerColor = Color(0xFFCAFFBF)),
                shape = RoundedCornerShape(10.dp),
                elevation = ButtonDefaults.buttonElevation(defaultElevation = 4.dp)
            ) {
                Text(text = "추출된 ${generatedTarotSets.size}개 타로 조합 내역에 저장하기", fontSize = 15.sp, fontWeight = FontWeight.Bold, color = Color(0xFF222222))
            }
            Spacer(modifier = Modifier.height(12.dp))
        }

        LazyColumn(
            modifier = Modifier
                .weight(1f)
                .fillMaxWidth(),
            verticalArrangement = Arrangement.spacedBy(10.dp)
        ) {
            if (tarotCardName != null && isFlipped) {
                item {
                    Card(
                        modifier = Modifier.fillMaxWidth(),
                        colors = CardDefaults.cardColors(containerColor = Color(0xFFFDFFB6)),
                        elevation = CardDefaults.cardElevation(defaultElevation = 2.dp),
                        shape = RoundedCornerShape(14.dp)
                    ) {
                        Column(modifier = Modifier.padding(16.dp)) {
                            Text(
                                text = tarotCardName ?: "",
                                style = MaterialTheme.typography.titleMedium,
                                color = Color(0xFF555555),
                                fontWeight = FontWeight.Bold
                            )
                            Spacer(modifier = Modifier.height(8.dp))
                            Text(text = tarotMeaning ?: "", style = MaterialTheme.typography.bodyMedium, fontWeight = FontWeight.SemiBold, color = Color(0xFF444444))
                        }
                    }
                }

                itemsIndexed(generatedTarotSets) { index, numbers ->
                    Card(
                        modifier = Modifier.fillMaxWidth(),
                        colors = CardDefaults.cardColors(containerColor = Color(0xFFE4C1F9)),
                        elevation = CardDefaults.cardElevation(defaultElevation = 1.dp),
                        shape = RoundedCornerShape(12.dp)
                    ) {
                        Column(modifier = Modifier.padding(14.dp)) {
                            Text(
                                text = "타로 맞춤 조합 ${index + 1}",
                                style = MaterialTheme.typography.labelSmall,
                                color = Color(0xFF666666),
                                fontWeight = FontWeight.Bold
                            )
                            Spacer(modifier = Modifier.height(8.dp))
                            Row(
                                modifier = Modifier.fillMaxWidth(),
                                horizontalArrangement = Arrangement.SpaceBetween
                            ) {
                                numbers.forEach { num ->
                                    TarotBallItem(number = num, size = 32)
                                }
                            }
                        }
                    }
                }
            } else {
                item {
                    Box(
                        modifier = Modifier
                            .fillMaxWidth()
                            .height(150.dp),
                        contentAlignment = Alignment.Center
                    ) {
                        Text(
                            text = "마음에 드는 카드를 터치하여 뒤집어보세요",
                            color = Color.Gray,
                            style = MaterialTheme.typography.bodyMedium
                        )
                    }
                }
            }
        }
    }
}

@Composable
fun TarotBallItem(number: Int, size: Int) {
    val ballColor = when (number) {
        in 1..10 -> Color(0xFFFFD166)
        in 11..20 -> Color(0xFF9BF6FF)
        in 21..30 -> Color(0xFFFFADAD)
        in 31..40 -> Color(0xFFBDB2FF)
        else -> Color(0xFFCAFFBF)
    }

    Box(
        contentAlignment = Alignment.Center,
        modifier = Modifier
            .size(size.dp)
            .background(color = ballColor, shape = CircleShape)
    ) {
        Text(
            text = number.toString(),
            color = Color(0xFF333333),
            fontWeight = FontWeight.Bold,
            fontSize = (size * 0.38).sp
        )
    }
}
