// File Path: app/src/main/java/com/kimro/ai/lotto/ui/tarot/TarotViewModel.kt
package com.kimro.ai.lotto.ui.tarot

import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import com.kimro.ai.lotto.data.repository.LottoRepository
import dagger.hilt.android.lifecycle.HiltViewModel
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import kotlinx.coroutines.launch
import javax.inject.Inject
import kotlin.random.Random

@HiltViewModel
class TarotViewModel @Inject constructor(
    private val repository: LottoRepository
) : ViewModel() {

    private val _tarotCardName = MutableStateFlow<String?>(null)
    val tarotCardName: StateFlow<String?> = _tarotCardName.asStateFlow()

    private val _tarotMeaning = MutableStateFlow<String?>(null)
    val tarotMeaning: StateFlow<String?> = _tarotMeaning.asStateFlow()

    private val _generatedTarotSets = MutableStateFlow<List<List<Int>>>(emptyList())
    val generatedTarotSets: StateFlow<List<List<Int>>> = _generatedTarotSets.asStateFlow()

    private val _saveMessage = MutableStateFlow<String?>(null)
    val saveMessage: StateFlow<String?> = _saveMessage.asStateFlow()

    // 긍정적 의미와 함께 뼈 때리는 현실적인 '주의점/경고' 메시지를 포함한 덱 구성
    private val tarotDeck = listOf(
        Pair(
            "0. 바보 (The Fool)", 
            "새로운 도전과 무한한 가능성의 기운입니다.\n\n⚠️ [쓴소리 조언] 계획 없는 충동적 번호 선택이나 무리한 소액 투자 남발은 지갑을 가볍게 만드는 지름길입니다."
        ),
        Pair(
            "1. 마법사 (The Magician)", 
            "뛰어난 창의력과 재능으로 원하는 결과를 이뤄내는 형국입니다.\n\n⚠️ [쓴소리 조언] 너무 복잡한 자신만의 통계 규칙에만 갇혀서 고집을 부리면 오히려 당첨에서 멀어집니다."
        ),
        Pair(
            "2. 여사제 (The High Priestess)", 
            "깊은 직관력과 통찰력이 빛을 발하는 날입니다.\n\n⚠️ [쓴소리 조언] 근거 없는 촉이나 꿈 자리에 지나치게 의존하여 평소 안 쓰던 번호만 고집하지 마세요."
        ),
        Pair(
            "3. 여황제 (The Empress)", 
            "풍요와 안정, 물질적인 성취와 재물복이 가득 찬 운세입니다.\n\n⚠️ [쓴소리 조언] 행운이 따른다고 방심하여 불필요한 예산을 초과해 구매하는 행위는 절대 금물입니다."
        ),
        Pair(
            "4. 황제 (The Emperor)", 
            "확고한 리더십과 결단력으로 큰 성과를 거머쥐는 기운입니다.\n\n⚠️ [쓴소리 조언] 내 고집대로만 번호를 밀고 나가는 아집이 오히려 확률을 떨어뜨리는 독이 될 수 있습니다."
        ),
        Pair(
            "7. 전차 (The Chariot)", 
            "거침없는 돌파력과 승리의 에너지가 가득합니다.\n\n⚠️ [쓴소리 조언] 마음이 앞서서 한 번에 너무 많은 조합을 무리하게 대량 구매하는 어리석음을 범하지 마세요."
        ),
        Pair(
            "10. 운명의 루비 (Wheel of Fortune)", 
            "인생의 거대한 행운의 흐름이 당신을 향하고 있습니다.\n\n⚠️ [쓴소리 조언] 기운이 좋을 때일수록 일확천금을 맹신하기보다 가벼운 오락과 즐거움으로 대해야 합니다."
        ),
        Pair(
            "19. 태양 (The Sun)", 
            "만물을 비추는 밝은 에너지와 최고의 행운, 대길의 기운입니다.\n\n⚠️ [쓴소리 조언] 지나친 낙관주의에 빠져 매주 고정으로 지출하는 생활비를 타로에 쏟아붓지 않도록 주의하세요."
        )
    )

    fun drawTarotCard(setCount: Int) {
        val selectedCard = tarotDeck.random()
        
        _tarotCardName.value = "[오늘의 타로: ${selectedCard.first}]"
        _tarotMeaning.value = selectedCard.second

        val sets = mutableListOf<List<Int>>()
        val seed = System.currentTimeMillis()

        for (i in 0 until setCount) {
            val setRandom = Random(seed + i * 99)
            val resultSet = mutableSetOf<Int>()

            while (resultSet.size < 6) {
                resultSet.add(setRandom.nextInt(1, 46))
            }
            sets.add(resultSet.sorted())
        }
        _generatedTarotSets.value = sets
    }

    fun saveAllTarotNumbers() {
        val currentSets = _generatedTarotSets.value
        if (currentSets.isNotEmpty()) {
            viewModelScope.launch {
                currentSets.forEach { numbers ->
                    repository.insertLotto(numbers, "TAROT")
                }
                _saveMessage.value = "성공적으로 ${currentSets.size}개의 타로 운세 조합이 내역에 저장되었습니다!"
            }
        }
    }

    fun clearSaveMessage() {
        _saveMessage.value = null
    }
}
